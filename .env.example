# Supabase Backend
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
# Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq AI API Key for translations and constitution assistant
# Get your free API key at: https://console.groq.com/
VITE_GROQ_API_KEY=your_groq_api_key_here

# Ghana NIA API (National Identification Authority)
# Contact NIA for official API access: https://nia.gov.gh
# Leave empty to use OCR-only verification
VITE_NIA_API_URL=
VITE_NIA_API_KEY=

# Super Admin Password for accessing admin panel
# Change this to your own secure password
VITE_SUPER_ADMIN_PASSWORD=your_secure_password_here
